# OpenAI-compatible chat completions (profile text, scheme matching, ID photos)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# TinyFish web agents. Each call is capped at 30s.
TINYFISH_API_KEY=

# Hackathon demo: cached schemes, sample ID, local form fill, practice status.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Optional. Status still updates if these are empty.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
OWNER_WHATSAPP=
